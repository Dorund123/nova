
import { createClient } from "@supabase/supabase-js";
import { NextRequest, NextResponse } from "next/server";

export const runtime = "nodejs";

const PACKAGES: Record<number, string> = {
  300: "novux-300",
  1000: "novux-1000",
  2500: "novux-2500",
  5000: "novux-5000",
  10000: "novux-10000",
};

type XsollaResponse = {
  token?: string;
  order_id?: number;
  errorMessage?: string;
  message?: string;
};

function isIPv4(ip: string): boolean {
  const parts = ip.split(".");
  return (
    parts.length === 4 &&
    parts.every(
      (part) =>
        /^\d{1,3}$/.test(part) &&
        Number(part) >= 0 &&
        Number(part) <= 255
    )
  );
}

export async function POST(request: NextRequest) {
  try {
    const supabaseUrl = process.env.NEXT_PUBLIC_SUPABASE_URL;
    const anonKey = process.env.NEXT_PUBLIC_SUPABASE_ANON_KEY;
    const projectId = process.env.XSOLLA_PROJECT_ID;
    const apiKey = process.env.XSOLLA_API_KEY;

    if (!supabaseUrl || !anonKey || !projectId || !apiKey) {
      return NextResponse.json(
        { error: "Payment settings are missing in Vercel." },
        { status: 500 }
      );
    }

    // Verify the logged-in Supabase user.
    const authorization = request.headers.get("authorization") || "";
    const accessToken = authorization.startsWith("Bearer ")
      ? authorization.slice(7)
      : "";

    if (!accessToken) {
      return NextResponse.json(
        { error: "Please log in first." },
        { status: 401 }
      );
    }

    const supabase = createClient(supabaseUrl, anonKey, {
      auth: {
        persistSession: false,
        autoRefreshToken: false,
      },
    });

    const {
      data: { user },
      error: authError,
    } = await supabase.auth.getUser(accessToken);

    if (authError || !user) {
      return NextResponse.json(
        { error: "Your session expired. Please log in again." },
        { status: 401 }
      );
    }

    // Accept only package amounts from the allowlist.
    let body: unknown;

    try {
      body = await request.json();
    } catch {
      return NextResponse.json(
        { error: "Invalid request body." },
        { status: 400 }
      );
    }

    if (
      typeof body !== "object" ||
      body === null ||
      !("amount" in body)
    ) {
      return NextResponse.json(
        { error: "Please select a Novux package." },
        { status: 400 }
      );
    }

    const amount = Number(body.amount);
    const sku = PACKAGES[amount];

    if (!sku) {
      return NextResponse.json(
        { error: "Invalid Novux package." },
        { status: 400 }
      );
    }

    const sandbox = process.env.XSOLLA_SANDBOX !== "false";

    const configuredUrl = process.env.NEXT_PUBLIC_APP_URL;
    const siteUrl = (
      configuredUrl || new URL(request.url).origin
    ).replace(/\/+$/, "");

    let siteOrigin: string;

    try {
      siteOrigin = new URL(siteUrl).origin;
    } catch {
      return NextResponse.json(
        { error: "The website URL is invalid." },
        { status: 500 }
      );
    }

    const tokenBody: Record<string, unknown> = {
      sandbox,
      user: {
        id: { value: user.id },
        name: {
          value:
            user.user_metadata?.username ||
            user.email?.split("@")[0] ||
            "Nova Player",
        },
        ...(user.email
          ? { email: { value: user.email } }
          : {}),
      },
      purchase: {
        items: [{ sku, quantity: 1 }],
      },
      settings: {
        currency: "USD",
        language: "en",
        return_url: siteOrigin,
      },
    };

    // Xsolla accepts an IPv4 address or a country code.
    // On Vercel, x-forwarded-for is normally populated by the platform.
    const forwardedFor =
      request.headers.get("x-forwarded-for") || "";
    const candidateIp = forwardedFor.split(",")[0].trim();

    const headers: Record<string, string> = {
      Authorization:
        "Basic " +
        Buffer.from(`${projectId}:${apiKey}`).toString("base64"),
      "Content-Type": "application/json",
      Accept: "application/json",
    };

    if (isIPv4(candidateIp)) {
      headers["X-User-Ip"] = candidateIp;
    } else {
      // Fallback country; users can change it in the payment UI.
      const user = tokenBody.user as Record<string, unknown>;
      user.country = {
        value: "GE",
        allow_modify: true,
      };
    }

    const response = await fetch(
      `https://store.xsolla.com/api/v3/project/${encodeURIComponent(
        projectId
      )}/admin/payment/token`,
      {
        method: "POST",
        headers,
        body: JSON.stringify(tokenBody),
        cache: "no-store",
      }
    );

    const responseText = await response.text();
    let result: XsollaResponse;

    try {
      result = JSON.parse(responseText) as XsollaResponse;
    } catch {
      console.error(
        "Xsolla returned a non-JSON response. HTTP status:",
        response.status
      );

      return NextResponse.json(
        { error: "Xsolla returned an invalid response." },
        { status: 502 }
      );
    }

    if (!response.ok || !result.token) {
      console.error("Xsolla token request failed:", {
        status: response.status,
        message: result.errorMessage || result.message,
      });

      return NextResponse.json(
        {
          error:
            result.errorMessage ||
            result.message ||
            "Could not create Xsolla checkout.",
        },
        { status: 502 }
      );
    }

    const checkoutHost = sandbox
      ? "https://sandbox-secure.xsolla.com/paystation4/"
      : "https://secure.xsolla.com/paystation4/";

    return NextResponse.json({
      success: true,
      orderId: result.order_id,
      checkoutUrl:
        checkoutHost + "?token=" + encodeURIComponent(result.token),
    });
  } catch (error) {
    console.error("Create-token error:", error);

    return NextResponse.json(
      { error: "Could not start payment. Try again later." },
      { status: 500 }
    );
  }
}
